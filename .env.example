# Required for a public deployment ----------------------------------------------
# Goes into the User-Agent sent to archive.org, per their bots policy.
CONTACT_EMAIL=you@example.com
# Public base URL of this server, used to build ResourceLink URIs.
# On Replit this is auto-detected from REPLIT_DOMAINS if left unset.
DEPLOY_URL=https://your-app.replit.app

# Recommended --------------------------------------------------------------------
# Unguessable path segment: MCP is served at /mcp/{MCP_PATH_SECRET}.
# Auto-generated (and logged once at boot) if unset — but it then changes on every
# restart, which breaks a saved connector URL. Set it explicitly in production.
MCP_PATH_SECRET=

# Optional -----------------------------------------------------------------------
# If set, requests must send `Authorization: Bearer <token>`. Defaults to unset.
MCP_AUTH_TOKEN=
# Registers the save_url tool (Save Page Now). Off by default.
ENABLE_SAVE=false
# Only raises Save Page Now rate limits; all query tools work anonymously.
IA_ACCESS_KEY=
IA_SECRET_KEY=
# Extra browser origins allowed to call /mcp and /r (comma separated).
ALLOWED_ORIGINS=
# Set to true to stream MCP POST responses as SSE instead of plain JSON.
MCP_SSE=false
# Upstream request budget knobs.
RATE_LIMIT_PER_MINUTE=10
UPSTREAM_TIMEOUT_MS=25000
PORT=3000
