{
  "name": "wayback-machine-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server exposing the Internet Archive (Wayback Machine + archive.org) as tools, designed for Replit Autoscale and claude.ai custom connectors.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "inspector": "npx -y @modelcontextprotocol/inspector"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "node-html-parser": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
